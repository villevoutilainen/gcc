#ifdef __cpp_lib_exchange_function // C++ >= 14
  /// Assign @p __new_val to @p __obj and return its previous value.
  template <typename _Tp, typename _Up = _Tp>
    _GLIBCXX20_CONSTEXPR
    inline _Tp
    exchange(_Tp& __obj, _Up&& __new_val)
    noexcept(__and_<is_nothrow_move_constructible<_Tp>,
		    is_nothrow_assignable<_Tp&, _Up>>::value)
    { return std::__exchange(__obj, std::forward<_Up>(__new_val)); }
#endif

#ifdef  __cpp_lib_as_const // C++ >= 17
  template<typename _Tp>
    [[nodiscard]]
    constexpr add_const_t<_Tp>&
    as_const(_Tp& __t) noexcept
    { return __t; }

  template<typename _Tp>
    void as_const(const _Tp&&) = delete;
#endif

#ifdef __cpp_lib_to_underlying // C++ >= 23
  /// Convert an object of enumeration type to its underlying type.
  template<typename _Tp>
    [[nodiscard, __gnu__::__always_inline__]]
    constexpr underlying_type_t<_Tp>
    to_underlying(_Tp __value) noexcept
    { return static_cast<underlying_type_t<_Tp>>(__value); }
#endif

#ifdef __cpp_lib_unreachable // C++ >= 23
  /// Informs the compiler that program control flow never reaches this point.
  /**
   * Evaluating a call to this function results in undefined behaviour.
   * This can be used as an assertion informing the compiler that certain
   * conditions are impossible, for when the compiler is unable to determine
   * that by itself.
   *
   * For example, it can be used to prevent warnings about reaching the
   * end of a non-void function without returning.
   *
   * @since C++23
   */
  [[noreturn,__gnu__::__always_inline__]]
  inline void
  unreachable()
  {
#ifdef _GLIBCXX_DEBUG
    std::__glibcxx_assert_fail(nullptr, 0, "std::unreachable()", nullptr);
#elif defined _GLIBCXX_ASSERTIONS
    __builtin_trap();
#else
    __builtin_unreachable();
#endif
  }
#endif


#ifdef __cpp_lib_observable_checkpoint // C++ >= 26
  /// Informs the compiler that prior actions are considered observable.
  /**
   * This may be used to limit the extent to which optimisations based on the
   * assumed unreachability of undefined behaviour can propagate to earlier
   * code.
   *
   * @since C++26
   */
  [[__gnu__::__always_inline__]]
  inline void
  observable_checkpoint() noexcept
  {
    return __builtin_observable_checkpoint();
  }
#endif

  /// P4222 (Initialization profile): assert that the [[ref_to_uninit]]
  /// memory *__p points to has been initialized (by some means the
  /// checker can't itself see -- e.g. placement construction through
  /// a differently-typed pointer, or a foreign/JIT-written buffer).
  /// An ordinary function, not compiler magic: [[must_init]]'s own
  /// semantics (the caller trusts the callee's declared postcondition
  /// without re-verifying its body -- see profiles.h's own
  /// profiles_uninit_flavor_at_position_p) are exactly what this
  /// needs, so the body below is a plain identity return.
  template<typename _Tp>
    [[__gnu__::__always_inline__]]
    constexpr _Tp*
    now_init(_Tp* __p [[must_init]]) noexcept
    { return __p; }

  /// P4222 (Initialization profile): assert that the *named object*
  /// __obj is now initialized -- unlike now_init() above, which asserts
  /// this of whatever a given pointer happens to point to, this
  /// attaches the assertion directly to the object itself, regardless
  /// of how it was actually initialized (including through indirection
  /// -- an intermediate pointer variable, a struct field, a foreign
  /// API -- that the checker's local, single-hop analysis can never
  /// trace, and is not attempting to: general pointer-aliasing analysis
  /// isn't solvable in general, so this sidesteps needing it rather
  /// than approximating it).  Useful precisely when there is no live
  /// pointer/reference back to the object visible at the point its
  /// initializedness needs to be asserted.
  template<typename _Tp>
    [[__gnu__::__always_inline__]]
    constexpr _Tp&
    now_init_in_place(_Tp& __obj [[must_init]]) noexcept
    { return __obj; }

  /// P4222 (Initialization profile): an address-taking escape hatch --
  /// unlike now_init()/now_init_in_place() above (which assert
  /// *initializedness*), this asserts nothing about __obj's contents.
  /// It exists solely so an [[uninit]] object's address can legitimately
  /// be passed to an arbitrary, unannotated function/constructor (one
  /// the checker has no way to know is [[ref_to_uninit]]-aware, e.g. a
  /// standard-library type not yet annotated for this profile) without
  /// tripping the checker's blanket "address taken outside a recognized
  /// [[must_init]]/[[ref_to_uninit]] call" rejection -- see this
  /// project's own now_init_in_place addendum notes for why no
  /// placement of profiles::suppress can substitute for this (that
  /// diagnostic is anchored at the object's own declaration, not at
  /// whichever statement actually escapes it).  Once escaped this way,
  /// the object can later be proven initialized with now_init_in_place
  /// (or now_init, through whatever pointer is actually doing the
  /// writing) exactly as if the escape had never happened; this
  /// function makes no promise of its own either way.
  template<typename _Tp>
    [[__gnu__::__always_inline__]]
    constexpr _Tp&
    escape_uninit(_Tp& __obj [[ref_to_uninit]]) noexcept
    { return __obj; }

  /// P3446R0 (Invalidation profile): assert -- without proof -- that
  /// the returned value contains no dangling pointer.  A local
  /// suppression of the invalidation profile's pointer/container
  /// escape-from-scope check (see invalidation-profile-gimple.cc's
  /// own recognition of a call to this exact function), the
  /// invalidation profile's analogue of now_init() above.
  template<typename _Tp>
    [[__gnu__::__always_inline__]]
    constexpr _Tp
    no_dangling(_Tp __x)
    { return __x; }

