/** @file contract_labels
 *  This is a Standard C++ Library header.
 */

#ifndef _GLIBCXX_CONTRACT_LABELS
#define _GLIBCXX_CONTRACT_LABELS 1

#pragma GCC system_header

#include <contracts>

#ifdef __cpp_lib_contracts

// D4324: std::contracts::P3400 (this branch's own library-only, best-
// effort approximation of WG21 P3400, "Controlling Contract-Assertion
// Properties") used to live directly inside <contracts> itself. Moved
// here, into its own, separate header, deliberately: P3400 is a library
// feature built *on top of* the core Contract Control Object surface
// (<contracts>'s own is_ignored/constify/assumable/validate/operator()
// dispatch, assertion_static_info, assertion_context,
// contract_validation_result, ...), not part of that surface itself --
// keeping it physically separate makes that layering visible, and frees
// this header to use whatever it likes (see below) without dragging
// those dependencies into <contracts>, which stays reachable from
// inside <type_traits>'s own transitive include chain (see <contracts>'s
// own "dependency-free" comment) and so can never itself include
// anything that pulls in <type_traits> -- <meta>, needed for the
// label-specific diagnostic strings below, most emphatically does.
// This header carries no such constraint: nothing in <type_traits>'s
// own chain needs P3400, so it is free to include <meta> (gated, like
// <meta> gates its own body, on reflection actually being enabled --
// see below) without any circularity risk.

#define __glibcxx_want_reflection
#define __glibcxx_want_define_static
#include <bits/version.h>

#if __glibcxx_reflection >= 202603L
#include <meta>
#endif

namespace std _GLIBCXX_VISIBILITY(default)
{
_GLIBCXX_BEGIN_NAMESPACE_VERSION

namespace contracts
{
  // D4324: a library-only, best-effort approximation of WG21 P3400
  // ("Controlling Contract-Assertion Properties"), built on top of
  // <contracts>'s own is_ignored/constify/assumable/validate/
  // operator() control-object dispatch, plus four independently-
  // motivated compiler changes: contract_control_bool_member (gcc/cp/
  // contracts.cc) makes a present-but-broken trait a real diagnosed
  // error instead of silently defaulting, and no longer requires these
  // traits to be static (label_base's own is_ignored/constify/
  // assumable/validate, and compute_semantic/group_names below, are
  // genuine instance methods, matching the paper); validate() itself
  // is a dedicated, optional acceptability gate the compiler dispatches
  // like any other trait, except that a clean fold to false is *itself*
  // diagnosed as a hard error (see label_base::validate's own comment)
  // -- used here so a disallowed evaluation semantic is rejected
  // directly, instead of is_ignored() having to break its own constant-
  // evaluation to smuggle that rejection through the "trait exists but
  // doesn't fold" diagnostic meant for genuine control-object bugs; and
  // -fcontracts-group-evaluation-semantic=group:semantic, wired
  // through assertion_static_info::group_semantic_rules() (see
  // __group_config_lookup below), gives group_names-driven build
  // configuration a real compiler hook. The control-object slot
  // already accepts an arbitrary constant-expression, not just a bare
  // name, so pre<terminating | review>(...) below already parses with
  // no parser changes at all, as long as the expression yields a class
  // type providing is_ignored/constify/assumable/validate/operator()
  // -- which every label here gets, for free, by deriving from
  // label_base.
  //
  // Disclosed, deliberate departures from the real paper:
  //  - local_violation_label's own handler receives this library's
  //    assertion_context, not a real std::contracts::contract_violation
  //    (that type's fields are private; building one is a compiler
  //    trick wired specifically for invoke_violation_handler, not for
  //    handing one back to arbitrary library code). Falling through to
  //    the real, replaceable global handler when a local handler
  //    declines (or is absent) is NOT an approximation, though: it goes
  //    through the real invoke_violation_handler.
  //  - queryable_label's query() is an ordinary member any label can
  //    implement and combined_label can delegate through, but there is
  //    no cross-TU ABI hook the way the real paper's
  //    contract_violation::query_control_object has.
  //  - validate() is not a P3400 facet at all: it is a general, D4324-
  //    only fifth Contract Control Object member (defined in
  //    <contracts>; see label_base's own comment just below), used
  //    here to implement allowed_semantics' rejection cleanly instead
  //    of is_ignored() breaking its own constant-evaluation to do it.
  //    Any real P3400 implementation would need its own, unspecified
  //    way to reject an unacceptable configuration; this branch's own
  //    answer to that is validate(), not something the paper itself
  //    defines.
  //  - label_base::validate's own rejection message names the specific
  //    label and the specific rejected evaluation_semantic via
  //    reflection (std::meta::display_string_of) and
  //    std::define_static_string, when this TU is built with
  //    -freflection; a fixed, generic message otherwise. Not part of
  //    the real paper (which says nothing about diagnostic text) or of
  //    P4324 itself (an ordinary, general-purpose use of the CCO
  //    surface, nothing P3400-specific about the *mechanism*).
  //  - Otherwise deliberately dependency-free beyond <contracts> and
  //    (when reflection is enabled) <meta>: every "concept" below uses
  //    only bare core-language requires-expressions (concept/requires
  //    need no header at all; only *using* a standard-library-provided
  //    concept like std::same_as would), evaluation_semantic_set is a
  //    hand-rolled bitmask, and group_names is a raw (pointer, count)
  //    pair.
  namespace P3400
  {
    // ---- Facet concepts (Section 3.3 of the paper) ----

    template <typename _Tp>
    concept assertion_control_object
      = requires { typename _Tp::assertion_control_object; };

    template <typename _Tp>
    concept allowed_semantics_label
      = assertion_control_object<_Tp> && requires { _Tp::allowed_semantics; };

    template <typename _Tp>
    concept semantic_computation_label
      = assertion_control_object<_Tp>
	// A genuine instance call, matching the paper's own
	// semantic_computation_label concept (which additionally requires
	// the result to be exactly evaluation_semantic -- not checked
	// here, same tradeoff as every other facet concept in this file:
	// see the "dependency-free" comment above): the compiler now
	// dispatches is_ignored (see label_base::is_ignored) against the
	// real control object, so compute_semantic can be a real,
	// per-instance member instead of being forced static.
	&& requires (const _Tp __t, evaluation_semantic __s)
	     { __t.compute_semantic (__s); };

    template <typename... _Dims>
    struct dimension_list { };

    template <typename _Tp>
    concept dimensioned_label
      = assertion_control_object<_Tp> && requires { typename _Tp::dimensions; };

    enum class violation_handled { not_handled, handled };

    template <typename _Tp>
    concept local_violation_label
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t, const assertion_context& __ctx)
	     { __t.handle_contract_violation (__ctx); };

    template <typename _Tp>
    concept identification_label
      // Instance access, matching the paper: group_names may be a real,
      // per-instance member now (see semantic_computation_label above
      // for why this no longer needs to be static).
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t) { __t.group_names; };

    template <typename _Tp>
    concept compute_comment_label
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t, const char* __c) { __t.compute_comment (__c); };

    template <typename _Tp>
    concept compute_message_label
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t, const char* __m) { __t.compute_message (__m); };

    template <typename _Tp>
    concept queryable_label
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t, const void* __k, __SIZE_TYPE__ __i)
	     { __t.query (__k, __i); };

    // Not a real P3400 facet (unlike every other concept in this file) --
    // this branch's own demonstration that a strongly-typed alternative
    // to queryable_label/query_control_object above needs no new
    // infrastructure beyond an ordinary hook, the same shape as
    // local_violation_label. query's own void*/key/index type erasure
    // exists only because the real paper commits to squeezing arbitrary
    // per-label data through one universal, generically-compiled
    // interception point (handle_contract_violation) whose signature can
    // never change per label -- a decoupled, replaceable extension point
    // doesn't inherently need that. A label modeling this facet can call
    // any ordinary, strongly-typed function it likes from notify() --
    // its own real data type, its own real handler function (declared
    // once, defined in exactly one TU, called from as many others as
    // want it: plain one-definition-rule linkage, nothing new) -- with
    // zero type erasure anywhere. The concept itself knows nothing about
    // what data a label constructs or what it calls: that's ordinary,
    // fully type-checked C++ inside notify()'s own body.
    template <typename _Tp>
    concept notify_label
      = assertion_control_object<_Tp>
	&& requires (const _Tp __t, const assertion_context& __ctx)
	     { __t.notify (__ctx); };

    // ---- Utilities (Section 3.4.4/3.4.6) ----

    // A set of evaluation_semantic values, backed by a plain bitmask
    // (no <bitset> needed: only 4 enumerators exist today).
    class evaluation_semantic_set
    {
      unsigned char _M_bits = 0;

      static constexpr unsigned char
      _S_bit (evaluation_semantic __s) noexcept
      {
	return static_cast<unsigned char>
	  (1u << (static_cast<unsigned> (__s) - 1));
      }

      constexpr explicit
      evaluation_semantic_set (unsigned char __bits) noexcept
      : _M_bits (__bits) { }

    public:
      constexpr evaluation_semantic_set () noexcept = default;

      template <typename... _Es>
      constexpr evaluation_semantic_set (_Es... __es) noexcept
      : _M_bits (static_cast<unsigned char> ((_S_bit (__es) | ... | 0u)))
      { }

      constexpr bool
      contains (evaluation_semantic __s) const noexcept
      { return (_M_bits & _S_bit (__s)) != 0; }

      constexpr bool empty () const noexcept { return _M_bits == 0; }

      constexpr evaluation_semantic_set
      operator& (evaluation_semantic_set __o) const noexcept
      { return evaluation_semantic_set (static_cast<unsigned char> (_M_bits & __o._M_bits)); }

      constexpr evaluation_semantic_set
      operator| (evaluation_semantic_set __o) const noexcept
      { return evaluation_semantic_set (static_cast<unsigned char> (_M_bits | __o._M_bits)); }

      // Not called operator~ (that would need a full complement,
      // meaningless without a fixed universe): removes one specific
      // semantic from the set instead, which is all the never_*
      // labels below actually need.
      constexpr evaluation_semantic_set
      without (evaluation_semantic __s) const noexcept
      { return evaluation_semantic_set (static_cast<unsigned char> (_M_bits & ~_S_bit (__s))); }

      static constexpr evaluation_semantic_set
      all () noexcept
      {
	return evaluation_semantic_set (evaluation_semantic::ignore,
					 evaluation_semantic::observe,
					 evaluation_semantic::enforce,
					 evaluation_semantic::quick_enforce);
      }

      static constexpr evaluation_semantic_set none () noexcept
      { return evaluation_semantic_set (); }
    };

    constexpr bool
    is_checked (evaluation_semantic __s) noexcept
    {
      return __s == evaluation_semantic::enforce
	     || __s == evaluation_semantic::quick_enforce
	     || __s == evaluation_semantic::observe;
    }

    constexpr bool
    is_unchecked (evaluation_semantic __s) noexcept
    { return __s == evaluation_semantic::ignore; }

    constexpr bool
    is_terminating (evaluation_semantic __s) noexcept
    {
      return __s == evaluation_semantic::enforce
	     || __s == evaluation_semantic::quick_enforce;
    }

    constexpr bool
    is_continuing (evaluation_semantic __s) noexcept
    { return __s == evaluation_semantic::observe || __s == evaluation_semantic::ignore; }

    // Used only by label_base::validate's own reflection-based message
    // (see below) -- a plain, dependency-free name lookup, not a P3400
    // facet.
    constexpr const char*
    __semantic_name (evaluation_semantic __s) noexcept
    {
      switch (__s)
	{
	case evaluation_semantic::ignore: return "ignore";
	case evaluation_semantic::observe: return "observe";
	case evaluation_semantic::enforce: return "enforce";
	case evaluation_semantic::quick_enforce: return "quick_enforce";
	}
      return "?";
    }

    // A minimal, dependency-free stand-in for a range of group names
    // (the real paper uses std::ranges::range<string_view>; this is
    // just a (pointer, count) pair over string literals, which already
    // have static storage duration, so no copying is ever needed).
    struct group_name_view
    {
      const char* const* _M_data = nullptr;
      __SIZE_TYPE__ _M_size = 0;

      constexpr const char* const* begin () const noexcept { return _M_data; }
      constexpr const char* const* end () const noexcept { return _M_data + _M_size; }
      constexpr __SIZE_TYPE__ size () const noexcept { return _M_size; }
    };

    // ---- group_semantic_rules()-driven group configuration ----
    //
    // Real, compiler-provided data now (see
    // assertion_static_info::group_semantic_rules(),
    // -fcontracts-group-evaluation-semantic=group:semantic): no text to
    // parse, no macro, no "unrecognized spelling" fallback needed --
    // the compiler already validated every rule's semantic spelling,
    // so RULES's own elements are already real evaluation_semantic
    // values.  Consulted in RULES's own order (== command-line order),
    // first match wins, against any of the label's own group names.
    //
    // _Names may be group_name_view (a simple label) or
    // __combined_group_names (see combined_label further down) -- both
    // are merely required to support range-for iteration over
    // const char*, so this is templated rather than fixed to one type.
    template <typename _Names>
    constexpr bool
    __group_config_lookup (const _Names& __names, group_semantic_rules_view __rules,
			   evaluation_semantic& __out) noexcept
    {
      for (auto& __rule : __rules)
	for (const char* __name : __names)
	  if (__builtin_strcmp (__name, __rule.group_name ()) == 0)
	    {
	      __out = __rule.semantic ();
	      return true;
	    }
      return false;
    }

    // ---- label_base<Self>: the public CRTP adapter ----
    //
    // Every label below (and combined_label further down) derives from
    // this directly (struct my_label : label_base<my_label> { ... };)
    // and thereby never has to declare is_ignored/constify/assumable/
    // validate/operator() itself -- only whichever P3400-shaped facet
    // members it wants to opt into. Third-party label authors are meant
    // to use this exactly the same way.
    //
    // is_ignored/constify/assumable/validate/__configured_semantic/
    // __effective_semantic are non-static (const instance) methods,
    // matching the paper: the compiler dispatches all of these against
    // the real, constant-evaluated control object (see
    // contract_control_bool_member/contract_control_validates in gcc/cp/
    // contracts.cc), not a dummy placeholder, so compute_semantic/
    // group_names below are free to be genuine per-instance members
    // instead of being forced static.
    template <typename _Self>
    struct label_base
    {
      // Shared by is_ignored and operator() below, so both agree on
      // the same effective semantic: ctx.semantic() (populated by the
      // compiler straight from -fcontract-evaluation-semantic=) is
      // deliberately NOT re-derived independently in operator() --
      // only is_ignored's own group-config-override +
      // compute_semantic pipeline, replayed here from the same
      // assertion_static_info (ctx.static_info()), decides both
      // whether to skip entirely (is_ignored) and, when not skipped,
      // what to report and whether to terminate (operator()).
      constexpr evaluation_semantic
      __configured_semantic (assertion_static_info __info) const noexcept
      {
	evaluation_semantic __configured = __info.semantic ();
	if constexpr (identification_label<_Self>)
	  {
	    evaluation_semantic __override;
	    if (__group_config_lookup (static_cast<const _Self&> (*this).group_names,
					__info.group_semantic_rules (),
					__override))
	      __configured = __override;
	  }
	return __configured;
      }

      constexpr evaluation_semantic
      __effective_semantic (evaluation_semantic __configured) const noexcept
      {
	if constexpr (semantic_computation_label<_Self>)
	  return static_cast<const _Self&> (*this).compute_semantic (__configured);
	else
	  return __configured;
      }

      constexpr bool
      is_ignored (assertion_static_info __info) const
      {
	evaluation_semantic __effective
	  = __effective_semantic (__configured_semantic (__info));
	return __effective == evaluation_semantic::ignore;
      }

      // Matches real C++26/P2900 constification semantics
      // unconditionally, unlike this branch's own default_control
      // (which deviates for reasons specific to its own design).
      constexpr bool
      constify (assertion_static_info) const noexcept { return true; }

      // Whenever this TU's actual configured (or group-config-overridden)
      // semantic falls outside an allowed_semantics_label's own allowed
      // set, that configuration is unacceptable for this assertion --
      // exactly the question validate() exists for, entirely separate
      // from is_ignored's own "should this run" question above.
      //
      // consteval, not constexpr: the reflection branch below calls
      // std::define_static_string, itself consteval, on a plain local
      // std::string -- a consteval callee's own arguments must already
      // be usable as constants at the point of that (nested) call,
      // which only holds if THIS function is itself an immediate
      // invocation throughout, not merely "possibly constant-evaluated"
      // like an ordinary constexpr function (confirmed via direct
      // testing: constexpr here fails with "call to consteval function
      // ... is not a constant expression", fixed by consteval here).
      // Harmless for the non-reflection fallback branch too, since the
      // compiler's own dispatch (contract_control_validates, gcc/cp/
      // contracts.cc) only ever calls validate() under forced constant
      // evaluation to begin with.
      consteval contract_validation_result
      validate (assertion_static_info __info) const
      {
	if constexpr (allowed_semantics_label<_Self>)
	  {
	    evaluation_semantic __effective
	      = __effective_semantic (__configured_semantic (__info));
	    if (evaluation_semantic_set (_Self::allowed_semantics).contains (__effective))
	      return { true };
#if __glibcxx_reflection >= 202603L
	    // Label-specific: names the actual control object's own type
	    // (not just "this control object", the old generic text) and
	    // the actual configured/rejected evaluation_semantic, built
	    // dynamically via an ordinary std::string and promoted to
	    // static storage via std::define_static_string -- exactly the
	    // reason this facility moved out of <contracts> into its own
	    // header, see this header's own top comment.
	    std::string __msg (std::meta::display_string_of (^^_Self));
	    __msg += " rejects the configured evaluation semantic '";
	    __msg += __semantic_name (__effective);
	    __msg += "'";
	    return { false, std::define_static_string (__msg) };
#else
	    // No -freflection: fall back to the old, fixed, dependency-
	    // free message (this header still works without reflection,
	    // just less specifically).
	    return { false, "this TU's configured (or group-overridden) "
			     "evaluation semantic is outside this control "
			     "object's own allowed_semantics set" };
#endif
	  }
	else
	  return { true };
      }

      // P3400 doesn't standardize an "assume" semantic yet; this
      // branch's existing, separate assume_v is untouched and not
      // combinable with this label framework.
      constexpr bool
      assumable (assertion_static_info) const noexcept { return false; }

      void
      operator() (const assertion_context& __ctx) const
      {
	if (__ctx.check ())
	  return;
	// Always notified on a real violation, independent of whether
	// local_violation_label (just below) goes on to suppress the
	// global handler -- matching the real paper's own owner_label
	// example, which combines alongside whatever else a label does
	// ("mail both committees on violations") rather than being
	// something the rest of the dispatch can skip.
	if constexpr (notify_label<_Self>)
	  static_cast<const _Self&> (*this).notify (__ctx);
	if constexpr (local_violation_label<_Self>)
	  {
	    if (static_cast<const _Self&> (*this).handle_contract_violation (__ctx)
		== violation_handled::handled)
	      return;
	  }
	const char* __comment = __ctx.comment ();
	if constexpr (compute_comment_label<_Self>)
	  __comment = static_cast<const _Self&> (*this).compute_comment (__comment);

	evaluation_semantic __effective
	  = __effective_semantic (__configured_semantic (__ctx.static_info ()));

	// Falls through to the REAL, user-replaceable global handler --
	// not an approximation, see invoke_violation_handler's own
	// comment (<contracts>). invoke_violation_handler deliberately
	// makes no severity/termination decision itself (see its own
	// comment); that stays this label's own responsibility, same as
	// every control type shipped in <contracts> (e.g.
	// noexcept_assert).
	assertion_info __info = __ctx.info ();
	__info.set_comment (__comment);
	__info.set_semantic (__effective);
	invoke_violation_handler (__info, detection_mode::predicate_false);
	if (is_terminating (__effective))
	  __d4324_terminate_wrapper ();
      }
    };

    // ---- General utilities (Section 3.4.6) ----
    //
    // Each of these derives from label_base too (unlike the paper's own
    // versions): in this branch, unlike a real P3400 implementation,
    // is_ignored/constify/assumable/operator() are the only things the
    // compiler ever actually calls, so any label meant to be usable on
    // its own -- not just as one operand later combined with another
    // via operator| -- needs them, even one participating in no facets
    // at all.

    struct empty_label_t : label_base<empty_label_t>
    {
      using assertion_control_object = empty_label_t;
    };
    inline constexpr empty_label_t empty_label{};

    template <evaluation_semantic... _Allowed>
    struct allowed_semantics_t : label_base<allowed_semantics_t<_Allowed...>>
    {
      using assertion_control_object = allowed_semantics_t;
      static constexpr evaluation_semantic_set allowed_semantics
	= evaluation_semantic_set (_Allowed...);
    };

    struct fixed_message_label_t : label_base<fixed_message_label_t>
    {
      using assertion_control_object = fixed_message_label_t;
      const char* _M_message;

      constexpr fixed_message_label_t (const char* __message) noexcept
      : _M_message (__message) { }

      constexpr const char*
      compute_message (const char*) const noexcept
      { return _M_message; }
    };

    // ---- Standard labels (Section 3.4.5) ----

    struct terminating_t : label_base<terminating_t>
    {
      using assertion_control_object = terminating_t;
      static constexpr evaluation_semantic_set allowed_semantics
	= evaluation_semantic_set (evaluation_semantic::enforce,
				   evaluation_semantic::quick_enforce);
    };
    inline constexpr terminating_t terminating{};

    struct symbolic_t : label_base<symbolic_t>
    {
      using assertion_control_object = symbolic_t;
      static constexpr evaluation_semantic_set allowed_semantics
	= evaluation_semantic_set (evaluation_semantic::ignore);
      // Not part of P3400 itself, but needed to actually deliver what
      // the paper's own symbolic label promises ("the predicate is an
      // unevaluated operand and may name functions that are declared
      // but not defined"): this branch's own, pre-existing is_symbolic
      // trait is exactly this fork's mechanism for that (see
      // build_contract_check's is_symbolic early-return and
      // std::is_object_address's own requirement of a symbolic- or
      // conveyor-checked predicate).
      static constexpr bool
      is_symbolic (assertion_static_info) noexcept { return true; }
    };
    inline constexpr symbolic_t symbolic{};

    // "Forces" per the paper: unlike terminating/symbolic (which only
    // restrict), always_<Sem> also unconditionally computes its own
    // fixed semantic regardless of this TU's configured one -- so
    // combining two distinct always_* labels correctly becomes
    // ill-formed via the allowed_semantics-intersection-empty static
    // check (each one's compute_semantic overrides the other's,
    // landing outside the other's single-value allowed_semantics),
    // matching "these labels are mutually exclusive".
    template <evaluation_semantic _Sem>
    struct __always_t : label_base<__always_t<_Sem>>
    {
      using assertion_control_object = __always_t;
      static constexpr evaluation_semantic_set allowed_semantics
	= evaluation_semantic_set (_Sem);
      constexpr evaluation_semantic
      compute_semantic (evaluation_semantic) const noexcept { return _Sem; }
    };
    inline constexpr __always_t<evaluation_semantic::enforce> always_enforce{};
    inline constexpr __always_t<evaluation_semantic::quick_enforce> always_quick_enforce{};
    inline constexpr __always_t<evaluation_semantic::observe> always_observe{};
    inline constexpr __always_t<evaluation_semantic::ignore> always_ignore{};

    // Purely restricts (removes _Sem from the allowed set), no forcing.
    template <evaluation_semantic _Sem>
    struct __never_t : label_base<__never_t<_Sem>>
    {
      using assertion_control_object = __never_t;
      static constexpr evaluation_semantic_set allowed_semantics
	= evaluation_semantic_set::all ().without (_Sem);
    };
    inline constexpr __never_t<evaluation_semantic::enforce> never_enforce{};
    inline constexpr __never_t<evaluation_semantic::quick_enforce> never_quick_enforce{};
    inline constexpr __never_t<evaluation_semantic::observe> never_observe{};
    inline constexpr __never_t<evaluation_semantic::ignore> never_ignore{};

    struct review_t : label_base<review_t>
    {
      using assertion_control_object = review_t;
      constexpr evaluation_semantic
      compute_semantic (evaluation_semantic __in) const noexcept
      { return is_terminating (__in) ? evaluation_semantic::observe : __in; }
    };
    inline constexpr review_t review{};

    // Whether this standard library was built (or this TU is being
    // compiled) with hardening enabled. A plain constexpr function
    // rather than an inline #ifdef, so any label -- not just hardened
    // below -- can query it without repeating the preprocessor check.
    constexpr bool
    hardening_enabled () noexcept
    {
#if defined (_GLIBCXX_ASSERTIONS)
      return true;
#else
      return false;
#endif
    }

    struct hardened_t : label_base<hardened_t>
    {
      using assertion_control_object = hardened_t;
      constexpr evaluation_semantic
      compute_semantic (evaluation_semantic __in) const noexcept
      {
	if (hardening_enabled ())
	  return evaluation_semantic::quick_enforce;
	return __in;
      }
    };
    inline constexpr hardened_t hardened{};

    // Shared by opt/audit below so that combining the two is ill-formed
    // (dimensioned_label's own overlap check, entirely independent of
    // group_names/identification_label): matches the paper's "opt and
    // audit... share a common dimension to avoid needing to determine
    // how an assertion will behave if a user marks it as both fast and
    // slow".
    struct __runtime_cost_dim { };

    struct opt_t : label_base<opt_t>
    {
      using assertion_control_object = opt_t;
      using dimensions = dimension_list<__runtime_cost_dim>;
      static constexpr const char* _S_names[1] = { "opt" };
      static constexpr group_name_view group_names{ _S_names, 1 };
    };
    inline constexpr opt_t opt{};

    struct audit_t : label_base<audit_t>
    {
      using assertion_control_object = audit_t;
      using dimensions = dimension_list<__runtime_cost_dim>;
      static constexpr const char* _S_names[1] = { "audit" };
      static constexpr group_name_view group_names{ _S_names, 1 };
    };
    inline constexpr audit_t audit{};

    // ---- Grouping labels: assertion_group_label<N> + operator""group ----

    // A class-type non-type template parameter (needs a fixed-size,
    // structural-comparable char array, not a pointer -- matching the
    // paper's own __assertion_group_label<N> design, not the raw
    // const-char*-based group_name_view used elsewhere in this file).
    template <__SIZE_TYPE__ _Nm>
    struct assertion_group_label_t
    {
      char _M_name[_Nm] = {};

      constexpr
      assertion_group_label_t (const char (&__name)[_Nm]) noexcept
      {
	for (__SIZE_TYPE__ __i = 0; __i != _Nm; ++__i)
	  _M_name[__i] = __name[__i];
      }
    };

    template <assertion_group_label_t _Label>
    struct __group_result_t : label_base<__group_result_t<_Label>>
    {
      using assertion_control_object = __group_result_t;
      static constexpr const char* _S_names[1] = { _Label._M_name };
      static constexpr group_name_view group_names{ _S_names, 1 };
    };

    // operator""group's own suffix ("group") isn't underscore-prefixed
    // -- like every other genuinely-reserved literal-operator suffix
    // this library defines (see basic_string's own operator""s in
    // bits/basic_string.h for the identical push/ignored/pop pattern),
    // this needs an explicit -Wliteral-suffix suppression: the warning
    // is a blanket "no non-underscore suffix" check with no built-in
    // notion of which suffixes are actually standard-reserved -- that
    // distinction only exists by convention, enforced here by hand.
    // Without this, a -pedantic-errors build fails to compile any
    // translation unit that transitively includes <contract_labels> at
    // all, found via a full, unfiltered testsuite sweep.
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wliteral-suffix"
    template <assertion_group_label_t _Label>
    constexpr auto
    operator""group () noexcept
    { return __group_result_t<_Label>{}; }
#pragma GCC diagnostic pop

    // ---- dimension_list<...> combination utilities (Section 3.3.3) ----

    template <typename _Tp, typename... _Rest>
    constexpr bool
    __dim_list_contains (dimension_list<_Rest...>) noexcept
    { return (false || ... || __is_same (_Tp, _Rest)); }

    template <typename... _D2>
    constexpr dimension_list<>
    __intersect_dim_lists (dimension_list<>, dimension_list<_D2...>) noexcept
    { return {}; }

    template <typename _Tp, typename... _D1, typename... _D2>
    constexpr auto
    __intersect_dim_lists (dimension_list<_Tp, _D1...>,
			   dimension_list<_D2...> __rhs) noexcept
    {
      if constexpr (__dim_list_contains<_Tp> (__rhs))
	{
	  auto __rest = __intersect_dim_lists (dimension_list<_D1...>{}, __rhs);
	  return [] <typename... _R> (dimension_list<_R...>) constexpr
	    { return dimension_list<_Tp, _R...>{}; } (__rest);
	}
      else
	return __intersect_dim_lists (dimension_list<_D1...>{}, __rhs);
    }

    template <typename... _D1, typename... _D2>
    constexpr dimension_list<_D1..., _D2...>
    __concat_dim_lists (dimension_list<_D1...>, dimension_list<_D2...>) noexcept
    { return {}; }

    template <typename... _Dims>
    constexpr __SIZE_TYPE__
    __dim_list_size (dimension_list<_Dims...>) noexcept
    { return sizeof... (_Dims); }

    template <typename _LHS, typename _RHS,
	      bool = dimensioned_label<_LHS>, bool = dimensioned_label<_RHS>>
    struct __combined_dimensions { using type = dimension_list<>; };

    template <typename _LHS, typename _RHS>
    struct __combined_dimensions<_LHS, _RHS, true, false>
    { using type = typename _LHS::dimensions; };

    template <typename _LHS, typename _RHS>
    struct __combined_dimensions<_LHS, _RHS, false, true>
    { using type = typename _RHS::dimensions; };

    template <typename _LHS, typename _RHS>
    struct __combined_dimensions<_LHS, _RHS, true, true>
    {
      static_assert (__dim_list_size (__intersect_dim_lists
	  (typename _LHS::dimensions{}, typename _RHS::dimensions{})) == 0,
	"combining labels with overlapping dimensions is ill-formed");
      using type = decltype (__concat_dim_lists (typename _LHS::dimensions{},
						 typename _RHS::dimensions{}));
    };

    // ---- combined_label<LHS, RHS> + operator| (Section 3.4.3) ----

    // A small range-like proxy concatenating two group_name_views
    // without needing to build a new, physically-contiguous array.
    struct __combined_group_names
    {
      group_name_view _M_lhs{};
      group_name_view _M_rhs{};

      struct iterator
      {
	const char* const* _M_cur;
	const char* const* _M_lhs_end;
	const char* const* _M_rhs_cur;

	constexpr const char*
	operator* () const noexcept
	{ return (_M_cur != _M_lhs_end) ? *_M_cur : *_M_rhs_cur; }

	constexpr iterator&
	operator++ () noexcept
	{
	  if (_M_cur != _M_lhs_end)
	    ++_M_cur;
	  else
	    ++_M_rhs_cur;
	  return *this;
	}

	constexpr bool
	operator!= (const iterator& __o) const noexcept
	{ return _M_cur != __o._M_cur || _M_rhs_cur != __o._M_rhs_cur; }
      };

      constexpr iterator
      begin () const noexcept
      { return { _M_lhs.begin (), _M_lhs.end (), _M_rhs.begin () }; }

      constexpr iterator
      end () const noexcept
      { return { _M_lhs.end (), _M_lhs.end (), _M_rhs.end () }; }
    };

    template <typename _LHS, typename _RHS>
    struct combined_label : label_base<combined_label<_LHS, _RHS>>
    {
      using assertion_control_object = combined_label;

      _LHS _M_lhs;
      _RHS _M_rhs;

      // Computed from the real _M_lhs/_M_rhs instances (unlike
      // allowed_semantics/dimensions below, group_names can be a
      // genuine per-instance member of _LHS/_RHS now -- see
      // identification_label's own comment), so this must be a regular
      // data member initialized at construction time, not a class-scope
      // static constant: the identification_label concept requires bare
      // member access (t.group_names, no call syntax), so it can't
      // become a plain member function either. Declared after _M_lhs/
      // _M_rhs so it's guaranteed to be constructed after them (C++
      // initializes members in declaration order regardless of
      // mem-initializer-list order).
      __combined_group_names group_names;

      static constexpr __combined_group_names
      __compute_group_names (const _LHS& __l, const _RHS& __r) noexcept
      {
	group_name_view __lv{};
	group_name_view __rv{};
	if constexpr (identification_label<_LHS>)
	  __lv = __l.group_names;
	if constexpr (identification_label<_RHS>)
	  __rv = __r.group_names;
	return { __lv, __rv };
      }

      constexpr
      combined_label (const _LHS& __lhs, const _RHS& __rhs) noexcept
      : _M_lhs (__lhs), _M_rhs (__rhs),
	group_names (__compute_group_names (_M_lhs, _M_rhs))
      { }

      using dimensions = typename __combined_dimensions<_LHS, _RHS>::type;

      // Intersection if both operands restrict; whichever one does if
      // only one does; unrestricted otherwise. The intersection-empty
      // check is a STATIC, build-independent property of the two
      // operands' own fixed allowed_semantics members -- genuinely
      // achievable as a real static_assert here, unlike the *dynamic*
      // (this-TU's-configured-semantic) check in label_base::validate,
      // which needs the Phase 0 compiler fix's own validate()-rejection
      // handling instead.
      static constexpr evaluation_semantic_set allowed_semantics =
	[] () constexpr
	{
	  if constexpr (allowed_semantics_label<_LHS> && allowed_semantics_label<_RHS>)
	    {
	      constexpr evaluation_semantic_set __r
		= evaluation_semantic_set (_LHS::allowed_semantics)
		  & evaluation_semantic_set (_RHS::allowed_semantics);
	      static_assert (!__r.empty (),
		"combining labels with disjoint allowed_semantics is ill-formed");
	      return __r;
	    }
	  else if constexpr (allowed_semantics_label<_LHS>)
	    return evaluation_semantic_set (_LHS::allowed_semantics);
	  else if constexpr (allowed_semantics_label<_RHS>)
	    return evaluation_semantic_set (_RHS::allowed_semantics);
	  else
	    return evaluation_semantic_set::all ();
	} ();

      // Non-static, matching the paper's own semantic_computation_label
      // concept (see its comment above): chained left to right over the
      // real _M_lhs/_M_rhs instances, exactly like compute_comment/
      // compute_message below, so a stateful operand's compute_semantic
      // genuinely sees its own instance data, not just its type.
      constexpr evaluation_semantic
      compute_semantic (evaluation_semantic __s) const noexcept
      {
	if constexpr (semantic_computation_label<_LHS>)
	  __s = _M_lhs.compute_semantic (__s);
	if constexpr (semantic_computation_label<_RHS>)
	  __s = _M_rhs.compute_semantic (__s);
	return __s;
      }

      // Chained right to left, per the paper: the right operand's
      // handler runs first; if it returns handled, the left operand's
      // handler is skipped.
      constexpr violation_handled
      handle_contract_violation (const assertion_context& __ctx) const
      {
	if constexpr (local_violation_label<_RHS>)
	  if (_M_rhs.handle_contract_violation (__ctx) == violation_handled::handled)
	    return violation_handled::handled;
	if constexpr (local_violation_label<_LHS>)
	  if (_M_lhs.handle_contract_violation (__ctx) == violation_handled::handled)
	    return violation_handled::handled;
	return violation_handled::not_handled;
      }

      constexpr const char*
      compute_comment (const char* __c) const noexcept
      {
	if constexpr (compute_comment_label<_LHS>)
	  __c = _M_lhs.compute_comment (__c);
	if constexpr (compute_comment_label<_RHS>)
	  __c = _M_rhs.compute_comment (__c);
	return __c;
      }

      constexpr const char*
      compute_message (const char* __m) const noexcept
      {
	if constexpr (compute_message_label<_LHS>)
	  __m = _M_lhs.compute_message (__m);
	if constexpr (compute_message_label<_RHS>)
	  __m = _M_rhs.compute_message (__m);
	return __m;
      }

      // Simplified relative to the paper: tries the left operand
      // first, then the right, rather than a binary-searched index
      // handoff -- fine as long as a given key is answered by at most
      // one of the two constituents, which holds for every label in
      // this file.
      constexpr void*
      query (const void* __key, __SIZE_TYPE__ __index) const
      {
	if constexpr (queryable_label<_LHS>)
	  if (void* __r = _M_lhs.query (__key, __index))
	    return __r;
	if constexpr (queryable_label<_RHS>)
	  return _M_rhs.query (__key, __index);
	return nullptr;
      }

      // Independent side effects, not a chained/composed value like
      // compute_comment/compute_message above -- order doesn't affect
      // correctness, but left-to-right matches this class's own
      // convention for the other left-to-right facets.
      constexpr void
      notify (const assertion_context& __ctx) const
      {
	if constexpr (notify_label<_LHS>)
	  _M_lhs.notify (__ctx);
	if constexpr (notify_label<_RHS>)
	  _M_rhs.notify (__ctx);
      }
    };

    template <assertion_control_object _LHS, assertion_control_object _RHS>
    constexpr combined_label<_LHS, _RHS>
    operator| (const _LHS& __lhs, const _RHS& __rhs) noexcept
    { return combined_label<_LHS, _RHS> (__lhs, __rhs); }

