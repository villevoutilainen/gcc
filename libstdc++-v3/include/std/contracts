/** @file contracts
 *  This is a Standard C++ Library header.
 */

#ifndef _GLIBCXX_CONTRACTS
#define _GLIBCXX_CONTRACTS 1

#pragma GCC system_header

#define __glibcxx_want_contracts
#define __glibcxx_want_replaceable_contract_violation_handler
#include <bits/version.h>

#ifdef __cpp_lib_contracts
#include <concepts>
#include <source_location>
#include <bits/exception_ptr.h>

namespace std _GLIBCXX_VISIBILITY(default)
{
_GLIBCXX_BEGIN_NAMESPACE_VERSION

namespace contracts
{
  // From P2900R14

  enum class assertion_kind : __UINT16_TYPE__ {
    pre = 1,
    post = 2,
    assert = 3,

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  enum class evaluation_semantic : __UINT16_TYPE__ {
    ignore = 1,
    observe = 2,
    enforce = 3,
    quick_enforce = 4,

    /* Implementation-defined values should have a minimum value of 1000.  */
  };

  enum class detection_mode : __UINT16_TYPE__ {
    predicate_false = 1,
    evaluation_exception = 2,

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  using __vendor_ext = void;

  class contract_violation {
    __UINT16_TYPE__ _M_version;
    assertion_kind _M_assertion_kind;
    evaluation_semantic _M_evaluation_semantic;
    detection_mode _M_detection_mode;
    const char* _M_comment;
    const void* _M_src_loc_ptr;
    __vendor_ext* _M_ext;

  public:
    // cannot be copied or moved or assigned to
    contract_violation(const contract_violation&) = delete;
    contract_violation& operator=(const contract_violation&) = delete;

    assertion_kind kind() const noexcept { return _M_assertion_kind; }
    evaluation_semantic semantic() const noexcept { return _M_evaluation_semantic; }
    detection_mode mode() const noexcept { return _M_detection_mode; }
    const char* comment() const noexcept { return _M_comment; }
    std::source_location location() const noexcept {
      std::source_location __loc;
      __loc._M_impl
	   = static_cast<const source_location::__impl*>(_M_src_loc_ptr);
      return __loc;
    }
    bool is_terminating () const noexcept {
      return _M_evaluation_semantic == std::contracts::evaluation_semantic::enforce
	    || _M_evaluation_semantic == std::contracts::evaluation_semantic::quick_enforce;
    }
  };

  void invoke_default_contract_violation_handler(const contract_violation&) noexcept;

  // D4324 "Minimum Language, Maximum Library" control-object surface.

  enum class evaluation_config : unsigned {
    ignore = 0, observe = 1, enforce = 2, quick_enforce = 3
  };

  // A control object's call operator returns void: returning means the
  // program continues past the assertion; to end the program the operator
  // terminates in its own body.  No violation_response is needed.

  template <class _Tp>
  concept assertion_control =
    __is_empty(_Tp) &&
    requires (_Tp __c, const char* __comment, std::source_location __loc,
	      evaluation_config __cfg) {
      { _Tp::is_ignored(__cfg) } -> same_as<bool>;
      { bool(_Tp::constify) };
      { bool(_Tp::assumable) };
      { __c(__comment, __loc, __cfg) } -> same_as<void>;
    };

  void __d4324_log_violation(const char*, std::source_location) noexcept;
  [[noreturn]] void __d4324_terminate() noexcept;

  struct default_control {
    static constexpr bool
    is_ignored(evaluation_config __cfg) noexcept
    { return __cfg == evaluation_config::ignore; }

    static constexpr bool constify  = false;
    static constexpr bool assumable = false;

    void
    operator()(const char* __comment, std::source_location __loc,
	       evaluation_config __cfg) const noexcept
    {
      __d4324_log_violation(__comment, __loc);
      if (__cfg != evaluation_config::observe)
	__d4324_terminate();
    }
  };

  inline constexpr default_control default_v{};

  struct review {
    static constexpr bool
    is_ignored(evaluation_config __cfg) noexcept
    { return __cfg == evaluation_config::ignore; }

    static constexpr bool constify  = true;
    static constexpr bool assumable = false;

    void
    operator()(const char* __comment, std::source_location __loc,
	       evaluation_config) const noexcept
    { __d4324_log_violation(__comment, __loc); }
  };

  inline constexpr review review_v{};

  struct mandatory {
    static constexpr bool
    is_ignored(evaluation_config __cfg) noexcept
    { return __cfg == evaluation_config::ignore; }

    static constexpr bool constify  = false;
    static constexpr bool assumable = true;

    [[noreturn]] void
    operator()(const char* __comment, std::source_location __loc,
	       evaluation_config) const noexcept
    {
      __d4324_log_violation(__comment, __loc);
      __d4324_terminate();
    }
  };

  inline constexpr mandatory mandatory_v{};

} // namespace contracts

_GLIBCXX_END_NAMESPACE_VERSION
} // namespace std

#endif // __cpp_lib_contracts
#endif // _GLIBCXX_CONTRACTS
