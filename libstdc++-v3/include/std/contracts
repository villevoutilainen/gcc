  // The user-facing control objects.  Unlike the library's own, in
  // <bits/contracts.h>, their violation reports format run-time data with
  // std::format (in a hosted build).
  inline namespace controls
  {

  // An operand of a violated assertion, printed with std::format if it
  // can be (in a hosted build) -- with the debug format ({:?}) where its
  // formatter has one, so strings and characters are quoted and escaped
  // -- else as __simple_print prints it.
  template<typename _Tp>
    void
    __rich_print_erased(__contract_text& __out, const void* __p)
    {
      const _Tp& __v = *static_cast<const _Tp*>(__p);
#if _GLIBCXX_HOSTED && __cpp_lib_format
      if constexpr (std::formattable<_Tp, char>)
	{
	  constexpr bool __debug = requires (std::formatter<_Tp, char>& __f)
	    { __f.set_debug_format(); };
	  auto __write = [&]
	    {
	      __SIZE_TYPE__ __room = __out._M_end - __out._M_cur;
	      if constexpr (__debug)
		__out._M_cur = std::format_to_n(__out._M_cur, __room, "{:?}",
						__v).out;
	      else
		__out._M_cur = std::format_to_n(__out._M_cur, __room, "{}",
						__v).out;
	    };
	  if constexpr (std::is_scalar_v<_Tp>)
	    // Can't throw: a valid format string for any scalar.
	    __write();
	  else
	    {
	      // A class's formatter may throw: the violation is still
	      // reported.
	      __try
		{
		  __write();
		}
	      __catch(...)
		{
		  __out.__put('?');
		}
	    }
	}
      else
#endif
	__simple_print(__out, __v);
    }

  // The message a violation report gives (see __operand_message), with
  // the operands printed richly.
  template<__SIZE_TYPE__ _Nm, typename... _Ops>
    const char*
    __rich_operand_message(char (&__buf)[_Nm], const assertion_context& __ctx,
			   const char* __message, const _Ops&... __ops)
    {
      const void* __ptrs[] = { static_cast<const void*>(__builtin_addressof(__ops))... };
      const __operand_printer __print[] = { &__rich_print_erased<_Ops>... };
      const __operand_printer __this_print[]
	= { __deref_string_printer<_Ops>::value... };
      return __operand_message(__buf, _Nm, __ctx, __message, __ptrs, __print,
			       __this_print, sizeof...(_Ops));
    }

  struct default_control : __annotation {
    using __annotation::__annotation;

    constexpr bool
    is_ignored(assertion_static_info __info) const noexcept
    { return __semantic(__info) == evaluation_semantic::ignore; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    // Not noexcept: an exception thrown by the predicate propagates to
    // the caller, neither terminating nor reported as a violation.
    // quick_enforce terminates at once, as a plain contract does under
    // -fcontract-evaluation-semantic=quick_enforce; otherwise the
    // replaceable violation handler is called, and an exception it throws
    // propagates.
    constexpr void
    operator()(const assertion_context& __ctx) const
    { __default_check(__ctx, __semantic(__ctx.static_info()), _M_message); }

    // With the condition's operands: the message gives their values.
    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      {
	if (__ctx.check())
	  return;
	const evaluation_semantic __sem = __semantic(__ctx.static_info());
	if consteval
	  {
	    __default_fail(__ctx, __sem, _M_message);
	  }
	else
	  {
	    if (__sem == evaluation_semantic::quick_enforce)
	      __default_fail(__ctx, __sem, _M_message);
	    else
	      {
  	    char __buf[__contract_message_size];
  	    __default_fail(__ctx, __sem,
  			   __rich_operand_message(__buf, __ctx, _M_message,
  						  __ops...));
	      }
	  }
      }
  };

  inline constexpr default_control default_v{};

  // default_control by the name it was first given.
  using annotated = default_control;

  struct review : __annotation {
    using __annotation::__annotation;

    constexpr bool
    is_ignored(assertion_static_info __info) const noexcept
    { return __semantic(__info) == evaluation_semantic::ignore; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return true; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    // Not noexcept: an exception thrown by the predicate or the violation
    // handler propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    {
      if (__ctx.check())
	return;
      __fail(__ctx, _M_message);
    }

    // With the condition's operands: the message gives their values.
    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      {
	if (__ctx.check())
	  return;
	if consteval
	  {
	    __fail(__ctx, _M_message);
	  }
	else
	  {
	    char __buf[__contract_message_size];
	    __fail(__ctx, __rich_operand_message(__buf, __ctx, _M_message,
						 __ops...));
	  }
      }

    // A violation, reported with MESSAGE.
    constexpr void
    __fail(const assertion_context& __ctx, const char* __message) const
    {
      if consteval
	{
	  // Never terminates at runtime, so never a compile-time error either.
	  constexpr_warning_str ("contract",
				 __message ? __message : __ctx.comment());
	}
      else
	{
	  assertion_info __info{__ctx.comment(), __ctx.location(),
				evaluation_semantic::observe, __ctx.kind()};
	  __info.set_message(__message);
	  invoke_violation_handler(__info, detection_mode::predicate_false);
	}
    }
  };

  inline constexpr review review_v{};

  // Unlike default_control/review above, mandatory really does mean
  // mandatory: is_ignored is unconditionally false (not just false-under-
  // enforce/observe, the way it used to be) and assumable is
  // unconditionally false too -- there is no -fcontract-evaluation-
  // semantic=ignore escape hatch that turns this into an unchecked
  // optimizer assumption instead of a real runtime check. Previously,
  // is_ignored returned true under =ignore specifically (with assumable
  // true alongside it, so the predicate was still handed to the optimizer
  // as an assumption even though never actually evaluated -- see
  // std::contracts::assume_v's own, deliberately different, "always
  // ignored+assumed regardless of TU config" contrast); found to
  // contradict this type's own name and its operator()'s own behavior
  // (which already unconditionally terminates on failure, "regardless of
  // semantic," independent of is_ignored/assumable). Every evaluation
  // semantic now gets the identical, real, enforced check below.
  struct mandatory : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept { return false; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    // Not noexcept: an exception thrown by the predicate or the violation
    // handler propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    {
      if (__ctx.check())
	return;
      __fail(__ctx, _M_message);
    }

    // With the condition's operands: the message gives their values.
    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      {
	if (__ctx.check())
	  return;
	if consteval
	  {
	    __fail(__ctx, _M_message);
	  }
	else
	  {
	    char __buf[__contract_message_size];
	    __fail(__ctx, __rich_operand_message(__buf, __ctx, _M_message,
						 __ops...));
	  }
      }

    // A violation, reported with MESSAGE.
    constexpr void
    __fail(const assertion_context& __ctx, const char* __message) const
    {
      if consteval
	{
	  // Always terminates at runtime, regardless of semantic, so always a
	  // compile-time error too.
	  constexpr_error_str ("contract",
			       __message ? __message : __ctx.comment());
	}
      else
	{
	  assertion_info __info{__ctx.comment(), __ctx.location(),
				evaluation_semantic::enforce, __ctx.kind()};
	  __info.set_message(__message);
	  invoke_violation_handler(__info, detection_mode::predicate_false);
	  __d4324_terminate_wrapper();
	}
    }
  };

  inline constexpr mandatory mandatory_v{};

  // What the symbolic control types do when a symbolic precondition finds
  // no record of its fact (-fcontract-symbolic-runtime-checks), as
  // default_control does for a false predicate: report the violation to
  // the replaceable violation handler with the configured semantic (an
  // exception it throws propagates), then terminate unless the semantic
  // is observe.  Quick-enforce terminates at once; ignore reports nothing.
  constexpr void
  __symbolic_fail(const assertion_context& __ctx, evaluation_semantic __sem,
		  const char* __message)
  {
    const char* __text = __message ? __message : __ctx.comment();
    if (__sem == evaluation_semantic::ignore)
      return;
    if consteval
      {
	if (__sem == evaluation_semantic::observe)
	  constexpr_warning_str ("contract", __text);
	else
	  constexpr_error_str ("contract", __text);
      }
    else
      {
	if (__sem != evaluation_semantic::quick_enforce)
	  {
	    // The predicate as the comment, the message alongside it.
	    assertion_info __info(__ctx.comment(), __ctx.location(), __sem,
				  __ctx.kind());
	    __info.set_message(__message);
	    invoke_violation_handler(__info, detection_mode::predicate_false);
	  }
	if (__sem != evaluation_semantic::observe)
	  __d4324_terminate_wrapper();
      }
  }

  constexpr void
  __symbolic_violation(const assertion_context& __ctx, evaluation_semantic __sem,
		       const char* __message)
  {
    if (__ctx.check())
      return;
    __symbolic_fail(__ctx, __sem, __message);
  }

  // ... with the condition's operands: the message gives their values.
  template<typename... _Ops>
    constexpr void
    __symbolic_violation(const assertion_context& __ctx,
			 evaluation_semantic __sem, const char* __message,
			 const _Ops&... __ops)
    {
      if (__ctx.check())
	return;
      if consteval
	{
	  __symbolic_fail(__ctx, __sem, __message);
	}
      else
	{
	  if (__sem == evaluation_semantic::ignore
	      || __sem == evaluation_semantic::quick_enforce)
	    __symbolic_fail(__ctx, __sem, __message);
	  else
	    {
	      char __buf[__contract_message_size];
	      __symbolic_fail(__ctx, __sem,
			      __rich_operand_message(__buf, __ctx, __message,
						     __ops...));
	    }
	}
    }

  // The is_symbolic-flavor mirror of conveyor_assert above: declares
  // is_symbolic() true instead of is_conveyor(), so a contract naming
  // this is checked under -fcontract-symbolic-proofs the ordinary way
  // (only when that flag is actually given -- unlike analyzed_symbolic_t/
  // proven_symbolic_t below, which force the analysis on regardless).
  struct symbolic_assert : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept { return false; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    static constexpr bool
    is_symbolic(assertion_static_info) noexcept { return true; }

    // Not noexcept: an exception thrown by the violation handler
    // propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message); }

    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message,
			     __ops...); }
  };

  inline constexpr symbolic_assert symbolic_assert_v{};

  // Identical to symbolic_assert above in every respect but one: this
  // additionally declares never_proven() true, exactly mirroring
  // never_proven_conveyor above (is_symbolic instead of is_conveyor) --
  // see its own documentation for the full rationale.
  struct never_proven_symbolic : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept { return false; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    static constexpr bool
    is_symbolic(assertion_static_info) noexcept { return true; }
    static constexpr bool
    never_proven(assertion_static_info) noexcept { return true; }

    // Not noexcept: an exception thrown by the violation handler
    // propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message); }

    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message,
			     __ops...); }
  };

  inline constexpr never_proven_symbolic never_proven_symbolic_v{};

  // The is_symbolic-flavor mirror of analyzed_conveyor_t above: declares
  // analyzed_symbolic() true, forcing -fcontract-symbolic-proofs-
  // equivalent analysis on regardless of the command-line flag, lenient
  // (unprovable warns). Not a P3400 label (deliberately outside label_
  // base's own dispatch, exactly like conveyor_assert/never_proven_
  // conveyor/analyzed_conveyor_t/proven_conveyor_t above, and exactly
  // like this file's own pre-existing is_symbolic precedent).
  struct analyzed_symbolic_t : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept { return false; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    static constexpr bool
    analyzed_symbolic(assertion_static_info) noexcept { return true; }

    // Not noexcept: an exception thrown by the violation handler
    // propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message); }

    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message,
			     __ops...); }
  };

  inline constexpr analyzed_symbolic_t analyzed_symbolic_v{};

  // Identical to analyzed_symbolic_t above, but declares proven_
  // symbolic() true instead: same forced-on analysis, but strict.
  struct proven_symbolic_t : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept { return false; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    static constexpr bool
    proven_symbolic(assertion_static_info) noexcept { return true; }

    // Not noexcept: an exception thrown by the violation handler
    // propagates to the caller.
    constexpr void
    operator()(const assertion_context& __ctx) const
    { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message); }

    template<typename... _Ops>
      constexpr void
      operator()(const assertion_context& __ctx, const _Ops&... __ops) const
      { __symbolic_violation(__ctx, __semantic(__ctx.static_info()), _M_message,
			     __ops...); }
  };

  inline constexpr proven_symbolic_t proven_symbolic_v{};

  struct ignore : __annotation {
    using __annotation::__annotation;

    static constexpr bool
    is_ignored(assertion_static_info) noexcept
    { return true; }

    static constexpr bool
    constify(assertion_static_info) noexcept { return false; }
    static constexpr bool
    assumable(assertion_static_info) noexcept { return false; }

    // Never actually called: is_ignored is unconditionally true
    // (regardless of the TU's -fcontract-evaluation-semantic=), so no
    // assertion naming this control ever reaches operator().
    constexpr void
    operator()(const assertion_context&) const noexcept
    { }
  };

  inline constexpr ignore ignore_v{};

  } // inline namespace controls

  // A violated assertion's condition with its operands' values, for a
  // control object's operator () taking the operands after the context:
  // CTX.static_info ().operand_format () with each operand's value in
  // place ("5 < s.size ()"), then, in brackets, the operands it leaves as
  // text ("[s: \"hello\"]"; 'this' only as the string it points to, for
  // a std::string or std::string_view).  Printed with std::format where
  // an operand can be (strings and characters quoted), else as simply as
  // the library's own control objects print, '?' at worst.  Empty without
  // a format string (-fcontract-violation-information=none).

  // Into BUF, of N bytes: truncated if longer, always NUL-terminated (N
  // at least 1); returns BUF.  Allocates nothing itself -- a user's own
  // formatter may.
  template<typename... _Ops>
    const char*
    format_operands_to(char* __buf, __SIZE_TYPE__ __n,
		       const assertion_context& __ctx, const _Ops&... __ops)
    {
      const void* __ptrs[]
	= { static_cast<const void*>(__builtin_addressof(__ops))..., nullptr };
      const __operand_printer __print[]
	= { &__rich_print_erased<_Ops>..., nullptr };
      const __operand_printer __this_print[]
	= { __deref_string_printer<_Ops>::value..., nullptr };
      if (!__ctx.static_info().operand_format())
	{
	  __buf[0] = '\0';
	  return __buf;
	}
      return __operand_message(__buf, __n, __ctx, nullptr, __ptrs, __print,
			       __this_print, sizeof...(_Ops));
    }

  template<__SIZE_TYPE__ _Nm, typename... _Ops>
    const char*
    format_operands_to(char (&__buf)[_Nm], const assertion_context& __ctx,
		       const _Ops&... __ops)
    { return std::contracts::format_operands_to(+__buf, _Nm, __ctx, __ops...); }

#if _GLIBCXX_HOSTED
  // ... as a std::string (of at most 4095 characters).
  template<typename... _Ops>
    std::string
    format_operands(const assertion_context& __ctx, const _Ops&... __ops)
    {
      char __buf[4096];
      return std::string(std::contracts::format_operands_to(__buf, __ctx,
							     __ops...));
    }
#endif

