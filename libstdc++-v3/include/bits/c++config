#if defined(_GLIBCXX_ASSERTIONS) && __STDC_HOSTED__ \
    && defined(__cpp_contracts) && __cpp_contracts >= 202502L \
    && defined(__cpp_contract_control_objects)
// D4324: when contract control objects are available in this TU, route
// through the same mechanism a user's own contracts use instead of the
// hardcoded __glibcxx_assert_fail/abort path below -- noexcept_assert's
// own is_ignored is unconditionally false, so this is exactly as active
// as the plain _GLIBCXX_ASSERTIONS path regardless of
// -fcontract-evaluation-semantic=, and its message-less default falls
// back to the predicate's own auto-derived condition text, reproducing
// this TU's existing diagnostic for every call site that doesn't supply
// its own message. __STDC_HOSTED__ guards against a freestanding build,
// where the contracts runtime support library (needed for
// noexcept_assert's violation-handler/terminate helpers) may not be
// available. Falls through to the unmodified tiers below whenever
// contracts (or control objects specifically) aren't enabled in the
// compiling TU -- the overwhelming common case is entirely unaffected.
//
// The actual #include <contracts> is deferred -- not to the end of this
// file, but all the way out to bits/version.h, right after *its own*
// #include of this file (see _GLIBCXX_CONTRACTS_DEFERRED_INCLUDE there).
// This point is reached mid-file, well before this file finishes
// defining its own later macros (e.g. _GLIBCXX_USE_BUILTIN_TRAIT, or the
// autoconf-detected macros appended wholesale after this template's own
// content, per include/Makefile.am's own build rule -- see "end of
// prewritten config" near this file's tail); <contracts> needs several
// of those (_GLIBCXX_HOSTED and friends) correctly defined, so the
// #include can't happen here.
//
// It also can't simply be deferred to this file's own tail instead (that
// was tried first): this file's include guard means a #include here
// that's merely deferred to *this file's own end* is still, in effect,
// happening from arbitrarily early in whichever translation unit first
// drags this header in -- and <contracts> no longer transitively needs
// <concepts>/<type_traits> at all (the one thing in it that ever did,
// the assertion_control concept, now lives in <concepts> itself, which
// already has what it needs -- see that header's own comment), so the
// circular-include failure that this same relocation-to-bits/version.h
// idea originally hit (a real regression compiling this repo's own
// d4324-conveyor-no-unreachable.C: <type_traits>'s own #include of
// bits/version.h, partway through <type_traits>'s own body, triggered a
// <contracts> pull that transitively needed is_same_v from that same,
// still-mid-body <type_traits>) no longer applies. bits/version.h is the
// right place for this precisely because it's *already* included from
// arbitrary, sometimes-mid-body points all over the library -- once
// <contracts> itself is safe to reach from any of them, doing the
// #include there (rather than here) is what actually guarantees this
// file's own later, autoconf-appended macros exist first, since
// bits/version.h's own #include of *this* file always returns after
// this file's full body -- including the appended tail -- is done.
# define _GLIBCXX_USE_CONTRACT_ASSERT 1
// A caller with its own message to report on failure, instead of
// noexcept_assert_v's own default of falling back to the predicate's
// auto-derived condition text: mainly for a caller whose own condition
// splices tokens from more than one macro expansion (e.g.
// debug/assertions.h's __glibcxx_requires_subscript, whose condition
// mixes a parameter substituted from the real call site with literal
// text written in its own macro body) -- CONTRACT_COMMENT's own
// "recover the real source text" step (get_source_text_between) needs
// a single, contiguous range in one file, which such a condition simply
// doesn't have, falling back to a pretty-printed, fully-qualified dump
// of the resolved tree instead. Message-carrying callers sidestep that
// by supplying MSG explicitly, typically itself built the same
// macro-expansion-independent way the pre-contracts __glibcxx_assert_fail
// used to (# stringification of just the real, call-site-supplied
// tokens, string-literal-concatenated with whatever literal text the
// condition also needs).
//
// _GLIBCXX_CONVEYOR_ASSERTIONS opts into a second, stricter flavor:
// conveyor_assert instead of noexcept_assert, routing __glibcxx_assert's
// condition (and every function it calls, tagged _GLIBCXX_CONVEYOR
// below) through GCC's mandatory conveyor UB-freedom checks. A separate
// macro, not a wholesale replacement, since the library functions this
// implies must be tagged _GLIBCXX_CONVEYOR are opted into one at a time
// (see std/array, bits/stl_vector.h) -- most of the library isn't tagged
// yet, so making this the default would break the untagged remainder.
# if defined(_GLIBCXX_CONVEYOR_ASSERTIONS)
#  define __glibcxx_assert(cond) \
     contract_assert<std::contracts::never_proven_conveyor_v>(cond)
#  define __glibcxx_assert_msg(cond, msg) \
     contract_assert<std::contracts::never_proven_conveyor(msg)>(cond)
# else
#  define __glibcxx_assert(cond) \
     contract_assert<std::contracts::noexcept_assert_v>(cond)
#  define __glibcxx_assert_msg(cond, msg) \
     contract_assert<std::contracts::noexcept_assert(msg)>(cond)
# endif
// For a condition whose own callee chain is known not to satisfy the
// mandatory conveyor UB-freedom rules (e.g. a reinterpret_cast reached
// through some accessor it calls) and so must never switch over to
// conveyor_assert regardless of _GLIBCXX_CONVEYOR_ASSERTIONS, unlike
// __glibcxx_assert above -- call sites opt into this spelling by name
// (bits/cow_string.h, bits/fs_path.h, std/text_encoding), rather than
// this header implicitly redefining __glibcxx_assert itself around them.
# define __glibcxx_assert_noconveyor(cond) \
     contract_assert<std::contracts::noexcept_assert_v>(cond)
# define __glibcxx_assert_msg_noconveyor(cond, msg) \
     contract_assert<std::contracts::noexcept_assert(msg)>(cond)
#elif defined(_GLIBCXX_ASSERTIONS)
// When _GLIBCXX_ASSERTIONS is defined we enable runtime assertion checks.
// These checks will also be done during constant evaluation.
# define __glibcxx_assert(cond)						\
  do {									\
    if (__builtin_expect(!bool(cond), false))				\
      _GLIBCXX_ASSERT_FAIL(cond);					\
  } while (false)
// No contract control objects here: MSG has nowhere to go, so it's
// simply dropped -- _GLIBCXX_ASSERT_FAIL's own #_Condition stringifies
// the raw condition tokens directly, which already reproduces a
// reasonable diagnostic regardless of macro-expansion origin.
# define __glibcxx_assert_msg(cond, msg) __glibcxx_assert(cond)
// No conveyor/non-conveyor distinction to make outside the contract-
// control-objects tier above: every assertion here is already the same,
// non-conveyor runtime check, so these are just aliases.
# define __glibcxx_assert_noconveyor(cond) __glibcxx_assert(cond)
# define __glibcxx_assert_msg_noconveyor(cond, msg) __glibcxx_assert(cond)
#elif _GLIBCXX_HAVE_IS_CONSTANT_EVALUATED
// _GLIBCXX_ASSERTIONS is not defined, so assertions checks are only enabled
// during constant evaluation. This ensures we diagnose undefined behaviour
// in constant expressions.
namespace std
{
  __attribute__((__always_inline__,__visibility__("default")))
  inline void
  __glibcxx_assert_fail()
  { }
}
# define __glibcxx_assert(cond)						\
  do {									\
    if (std::__is_constant_evaluated() && !bool(cond))			\
      std::__glibcxx_assert_fail();					\
  } while (false)
# define __glibcxx_assert_msg(cond, msg) __glibcxx_assert(cond)
# define __glibcxx_assert_noconveyor(cond) __glibcxx_assert(cond)
# define __glibcxx_assert_msg_noconveyor(cond, msg) __glibcxx_assert(cond)
#else
// _GLIBCXX_ASSERTIONS is not defined and __is_constant_evaluated() doesn't
// work so don't check any assertions.
# define __glibcxx_assert(cond)
# define __glibcxx_assert_msg(cond, msg)
# define __glibcxx_assert_noconveyor(cond)
# define __glibcxx_assert_msg_noconveyor(cond, msg)
#endif

// How an individual library function gets tagged conveyor "conditionally,
// when [_GLIBCXX_CONVEYOR_ASSERTIONS] is defined" -- expands to GCC's
// 'conveyor' function-specifier only when both this macro and the
// compiler support it actually claims to back are present, else to
// nothing at all, so a build with _GLIBCXX_CONVEYOR_ASSERTIONS defined
// but an older/differently-configured compiler degrades silently to an
// ordinary, unchecked function instead of a hard parse error.
#ifndef _GLIBCXX_CONVEYOR
# if defined(_GLIBCXX_CONVEYOR_ASSERTIONS) && defined(__cpp_contract_control_objects)
#  define _GLIBCXX_CONVEYOR conveyor
# else
#  define _GLIBCXX_CONVEYOR
# endif
#endif

// Declaration-level macros for _GLIBCXX_PRECONDITION_ASSERTIONS: turn a
// library function's own already-conveyor-routed in-body assert (see
// debug/assertions.h's own __glibcxx_requires_subscript and friends, which
// these are named after) into a genuine declared pre<>() on that same
// function's declaration, so callers -- not just the function's own body --
// are subject to static proof. Uses plain std::contracts::conveyor_
// assert_v directly, deliberately not the std::contracts::never_proven_
// conveyor_v that __glibcxx_assert itself routes through under
// _GLIBCXX_CONVEYOR_ASSERTIONS: a declared precondition is meant to stay
// checkable at its own call sites, unlike the library's own not-yet-
// migrated internal asserts (see that macro's own comment above).
// D4324/P2680: SUBSCRIPT/NONEMPTY's own condition calls size()/empty(),
// both _GLIBCXX_CONVEYOR-tagged -- under the reference/this self-trust
// soundness fix, that mandates is_object_address(this) proven at every
// call site, including this macro's own member function (never
// conveyor-declared itself). Adding it here, once, covers every
// container using either macro instead of needing the same fix at each
// individual call site. Gated identically to max_size_type.h's own
// analogous fix (see that header's own comment for the never_proven_
// conveyor_v rationale); a "for now" pattern, not a final design --
// see task #176's own follow-up. NON_EMPTY_RANGE/NONZERO_DIVISOR are
// used from free functions with no 'this' in scope and don't call any
// conveyor accessor, so they're left unchanged.
#if defined(_GLIBCXX_PRECONDITION_ASSERTIONS) && defined(__cpp_contract_control_objects)
# define _GLIBCXX_PRECONDITION_SUBSCRIPT(_N) \
    pre<std::contracts::never_proven_conveyor_v>(std::is_object_address (this)) \
    pre<std::contracts::conveyor_assert_v>(_N < size())
# define _GLIBCXX_PRECONDITION_NONEMPTY() \
    pre<std::contracts::never_proven_conveyor_v>(std::is_object_address (this)) \
    pre<std::contracts::conveyor_assert_v>(!empty())
# define _GLIBCXX_PRECONDITION_NON_EMPTY_RANGE(_First, _Last) \
    pre<std::contracts::conveyor_assert_v>(_First != _Last)
# define _GLIBCXX_PRECONDITION_NONZERO_DIVISOR(_Y) \
    pre<std::contracts::conveyor_assert_v>(_Y != 0)
#else
# define _GLIBCXX_PRECONDITION_SUBSCRIPT(_N)
# define _GLIBCXX_PRECONDITION_NONEMPTY()
# define _GLIBCXX_PRECONDITION_NON_EMPTY_RANGE(_First, _Last)
# define _GLIBCXX_PRECONDITION_NONZERO_DIVISOR(_Y)
#endif

// Same as _GLIBCXX_CONVEYOR just above, but for a function template
// whose conveyor-ness is only ever true for some of its
// instantiations (e.g. a customization-point object dispatching, via
// 'if constexpr', to a type's own possibly-conveyor member function):
// 'conveyor(auto)' deduces this per instantiation instead of requiring
// it of all of them unconditionally, so an instantiation for a type
// that doesn't happen to qualify is simply an ordinary function
// instead of a hard error -- see D4324's own conveyor(auto) feature.
// Degrades the same way _GLIBCXX_CONVEYOR does when unsupported;
// __cpp_contract_control_objects is presently a plain boolean-valued
// (not versioned) macro, so, like _GLIBCXX_CONVEYOR, this can't
// distinguish a compiler new enough for bare 'conveyor' but not yet
// for 'conveyor(auto)' -- not a concern for this single-implementation
// experimental extension.
#ifndef _GLIBCXX_CONVEYOR_AUTO
# if defined(_GLIBCXX_CONVEYOR_ASSERTIONS) && defined(__cpp_contract_control_objects)
#  define _GLIBCXX_CONVEYOR_AUTO conveyor(auto)
# else
#  define _GLIBCXX_CONVEYOR_AUTO
# endif
#endif

// Same as _GLIBCXX_CONVEYOR above, but for a function whose safety as a
// conveyor function depends on a *declared* precondition (one of the
// _GLIBCXX_PRECONDITION_* macros just above), not on being unconditionally
// safe. Gated on _GLIBCXX_PRECONDITION_ASSERTIONS rather than plain
// _GLIBCXX_CONVEYOR_ASSERTIONS: since the former only holds when the latter
// also does (see this file's own auto-#undef a few hundred lines up), a
// function tagged with this macro can never end up 'conveyor' without its
// own backing pre<>() also being present -- unlike using plain
// _GLIBCXX_CONVEYOR here, which would let a build with
// _GLIBCXX_CONVEYOR_ASSERTIONS defined but not _GLIBCXX_PRECONDITION_
// ASSERTIONS tag the function conveyor while its own precondition macro
// independently collapses to nothing, leaving a conveyor function with an
// undeclared obligation backing its own body. See bits/sat_arith.h's own
// saturating_div for the first user of this macro.
#ifndef _GLIBCXX_CONVEYOR_PRE
# if defined(_GLIBCXX_PRECONDITION_ASSERTIONS) && defined(__cpp_contract_control_objects)
#  define _GLIBCXX_CONVEYOR_PRE conveyor
# else
#  define _GLIBCXX_CONVEYOR_PRE
# endif
#endif

